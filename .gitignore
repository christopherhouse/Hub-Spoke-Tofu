# Compiled Bicep output. The .bicep sources are the source of truth; ARM JSON is a build
# artifact. Templates are compiled during deployment, never committed.
infra/**/*.json
!bicepconfig.json

# Local parameter files. Committed parameter files carry no secrets, but local overrides
# may contain subscription IDs or scratch values.
*.local.bicepparam
*.local.json

# Deployment output captured locally
*.whatif
*.deployment.json

# Credentials and environment files
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Azure CLI artifacts
.azure/

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# Local test and coverage output
coverage/
test-results/
